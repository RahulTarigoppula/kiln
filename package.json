{
  "name": "kiln",
  "version": "0.1.0",
  "description": "A WebGPU deep-learning framework written from scratch in TypeScript: tensors, autograd, WGSL kernels, transformers. Train a GPT in a browser tab.",
  "type": "module",
  "license": "MIT",
  "author": "Rahul Tarigoppula",
  "repository": "github:RahulTarigoppula/kiln",
  "homepage": "https://rahultarigoppula.github.io/kiln/",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "train:tiny": "node --import tsx scripts/train-tiny.ts",
    "bench": "node --import tsx scripts/bench-cpu.ts",
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@webgpu/types": "^0.1.60",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
